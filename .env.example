# Runner-skriptene leser denne automatisk. I GitHub Actions settes det samme som variabler/secrets.

# ---- Felles ----
# TEAM=                           # kun for Azure Blob Storage: øverste mappe i lagringen
ZAP_FAIL_ON=high                   # info | low | medium | high. Skannet feiler ved funn på dette nivået eller høyere.
# ZAP_STORAGE_ACCOUNT=             # sett for å laste opp til felles lagring etter skannet (krever az login)
# ZAP_IMAGE=zaproxy/zap-stable
# ZAP_DOCKER_MEMORY=4g

# ---- API-skann (plans/zap-api.yaml) ----
API_PROJECT=                       # navn på API-et, brukes i rapportstien
API_BASE='<API_BASE_URL>'
OPENAPI_SPEC_URL='<OPENAPI_SPEC_URL>'
TOKEN_URL='https://<TOKEN_GENERATOR_URL>?env=<ENV>&scopes=<SCOPES>&orgNo=<ORG_NO>&org=<ORG_NAME>'
TOKEN_BASIC_AUTH='Basic <base64>'

# ---- Web-skann (plans/zap-web.yaml) ----
WEB_PROJECT=                       # navn på appen, brukes i rapportstien
WEB_TARGET='https://ttd.apps.tt02.altinn.no/ttd/<PROJECT_NAME>'
PLAYWRIGHT_BASE_URL=               # URL det logges inn på (ofte lik WEB_TARGET)
# ZAP_PORT=8080                    # lokal port ZAP-proxyen eksponeres på
# PLAYWRIGHT_STORAGE_STATE=playwright/auth.json
# PLAYWRIGHT_SSO_REGEX=login\\.test\\.idporten\\.no|testid\\.test\\.idporten\\.no
# PLAYWRIGHT_TRAFFIC_WAIT_MS=8000
# PLAYWRIGHT_HEADED=1              # vis nettleseren lokalt ved feilsøking
# TEST_USER_PID=                   # eller det innloggingen i playwright/global-setup.ts trenger
